# Environment variables for PIM3 Chat AI Project

# OpenRouter API Key (Recomendado: https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# Google Gemini API Key (Alternativo: https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Opcional: Forzar modelo específico en OpenRouter
# OPENROUTER_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
